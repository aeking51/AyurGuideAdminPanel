# ==============================================================================
# AyurGuide Clinical Admin Portal — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# In Vite / React web apps, client-side environment variables MUST be prefixed
# with VITE_ to be exposed to browser code (via import.meta.env).
#
# Obtain these from your Supabase Dashboard:
# -> Project Settings -> API -> Project URL & Project API Keys (anon public)
VITE_SUPABASE_URL=https://ksnsfilauqzxsegpjpdt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Standard platform naming fallbacks (supported by vite.config.ts envPrefix)
SUPABASE_URL=https://ksnsfilauqzxsegpjpdt.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. VERCEL DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# When deploying to Vercel (https://vercel.com):
# 1. Import your GitHub repository.
# 2. Select Framework Preset: "Vite"
# 3. Build Command: "npm run build"
# 4. Output Directory: "dist"
# 5. Under "Environment Variables", add:
#    - VITE_SUPABASE_URL = https://ksnsfilauqzxsegpjpdt.supabase.co
#    - VITE_SUPABASE_ANON_KEY = <your-anon-key>
#
# ------------------------------------------------------------------------------
# 3. GITHUB ACTIONS / SECRETS CONFIGURATION
# ------------------------------------------------------------------------------
# Under GitHub Repo -> Settings -> Secrets and variables -> Actions:
# Add Repository Secrets:
#    - VITE_SUPABASE_URL
#    - VITE_SUPABASE_ANON_KEY
#
# ------------------------------------------------------------------------------
# 4. GOOGLE AI STUDIO SECRETS
# ------------------------------------------------------------------------------
# Open the Secrets panel (Key icon) in the AI Studio sidebar to inject:
#    - GEMINI_API_KEY
#    - VITE_SUPABASE_ANON_KEY
# ==============================================================================
